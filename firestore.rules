rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Kullanıcılar: herkes kendi profiline erişir.
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // Haberler: herkes okuyabilir, yalnızca admin yazabilir.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Fotoğraflar: herkes okuyabilir, yalnızca admin yazabilir.
    // Görseller Storage yerine küçültülüp base64 olarak kaydedilir (belge limiti ~1MB).
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.imageUrl.size() <= 750000
        && request.resource.data.thumbnailUrl is string
        && request.resource.data.thumbnailUrl.size() > 0
        && request.resource.data.thumbnailUrl.size() <= 750000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Etkinlikler: herkes okuyabilir, yalnızca admin yazabilir.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.date is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Duyurular: herkes okuyabilir, yalnızca admin yazabilir.
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Çekilişler: herkes okuyabilir; oturum açmış herkes katılabilir
    // (sayaç arttırma), admin ekleme/silme yapabilir.
    match /giveaways/{giveawayId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.endDate is string;
      allow update: if isAdmin() || (isSignedIn()
        && request.resource.data.diff( resource.data ).affectedKeys()
           .hasOnly(['participants'])
        && request.resource.data.participants == resource.data.participants + 1);
      allow delete: if isAdmin();
    }

    // Köy hikayeleri: herkes okuyabilir, yalnızca admin yazabilir.
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Tarihi eserler: herkes okuyabilir, yalnızca admin yazabilir.
    match /heritage/{heritageId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Ayarlar: salt okunur (ör. site duyurusu banner'ı).
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}