rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data.role == 'admin';
    }

    // Fotoğraf şubeleri: herkes okuyabilir,
    // yalnızca admin resim dosyası yükleyebilir/ silebilir.
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Genel: diğer şubelere yalnızca giriş yapanlar, salt yazma reddi.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}